# Core app settings
APP_ENV=production
APP_NAME=Query-Aware Prompt Compressor
DEVICE=cpu
MAX_LENGTH=512
CORS_ORIGINS=*

# Model and retrieval paths
MODEL_DIR=submission_artifacts/model
RAG_FAISS_INDEX_PATH=corpus/index

# Compressor options
# local | (empty for remote default) 
RAG_COMPRESSOR_TYPE=
# Used when RAG_COMPRESSOR_TYPE is empty; defaults to nnnhitesh/TokenCompressor if unset
RAG_COMPRESSOR_ENDPOINT=

# Generator options
# mock keeps deployment free and keyless
RAG_GENERATOR_PROVIDER=mock
RAG_GENERATOR_MODEL=
RAG_GENERATOR_BASE_URL=
RAG_GENERATOR_API_KEY=

# Optional provider-specific keys (used only when not in mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
